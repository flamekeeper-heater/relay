{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flamekeeper-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  // The relay's own log lines only: invocation logs would keep client addresses and headers.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Only the custom domains below: no workers.dev address, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,

  // The official relay's own subdomain (the DNS record is created on first deploy). To run your
  // own, put your host here (README.md, "Run your own").
  "routes": [{ "pattern": "relay.flamekeeper.app", "custom_domain": true }],

  // The APNs topic, and "1" once Apple grants the Critical Alerts entitlement (class 3 then goes
  // out critical, else time-sensitive). The APNs key is three secrets (README.md); without
  // them the relay answers registrations "push not available".
  "vars": { "BUNDLE_ID": "app.flamekeeper.Flamekeeper", "CRITICAL_ALERTS": "0" },

  // One Durable Object per board id: the board's socket, its phones' sockets, the roster and the
  // push registrations (SQLite). One more, named "apns", sends every push to Apple.
  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "BoardRoom" },
      { "name": "PUSH", "class_name": "PushSender" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["PushSender"] }
  ],

  // Connects per client address a minute (Workers rate limiting). A namespace_id must be unique in
  // the Cloudflare account: change these if another Worker there uses them.
  "ratelimits": [
    { "name": "BOARD_CONNECTS", "namespace_id": "4001", "simple": { "limit": 20, "period": 60 } },
    { "name": "APP_CONNECTS", "namespace_id": "4002", "simple": { "limit": 60, "period": 60 } },
    // PUSH messages per board id a minute (an alarm, class 3, is never limited).
    { "name": "PUSH_RATE", "namespace_id": "4003", "simple": { "limit": 20, "period": 60 } }
  ],

  "env": {
    // A test deploy beside the official one: `npx wrangler deploy --env test`.
    "test": {
      "routes": [{ "pattern": "relay-test.flamekeeper.app", "custom_domain": true }],
      // vars are not inherited by an environment: the same as above.
      "vars": { "BUNDLE_ID": "app.flamekeeper.Flamekeeper", "CRITICAL_ALERTS": "0" },
      "durable_objects": {
        "bindings": [
          { "name": "BOARD", "class_name": "BoardRoom" },
          // The official relay's APNs sender: both deployments sign with one APNs key, and Apple
          // refuses a key's new provider tokens more often than every 20 minutes, so one object
          // makes them. With an APNs key of its own, drop "script_name".
          { "name": "PUSH", "class_name": "PushSender", "script_name": "flamekeeper-relay" }
        ]
      },
      "ratelimits": [
        { "name": "BOARD_CONNECTS", "namespace_id": "4011", "simple": { "limit": 20, "period": 60 } },
        { "name": "APP_CONNECTS", "namespace_id": "4012", "simple": { "limit": 60, "period": 60 } },
        { "name": "PUSH_RATE", "namespace_id": "4013", "simple": { "limit": 20, "period": 60 } }
      ]
    }
  }
}
